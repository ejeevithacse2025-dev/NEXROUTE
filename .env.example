# Server Environment Variables
NODE_ENV=development
PORT=3001
JWT_SECRET=nexroute_jwt_secret_change_in_production_2024
JWT_EXPIRES_IN=7d

# Database (SQLite fallback - default)
DATABASE_URL="file:./nexroute.db"

# PostgreSQL (optional - set USE_POSTGRES=true to use with Docker)
USE_POSTGRES=false
POSTGRES_URL="postgresql://nexroute:nexroute_secret@localhost:5432/nexroute"

# CORS
CLIENT_URL=http://localhost:5173

# File uploads
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads
